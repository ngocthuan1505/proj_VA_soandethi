{
  "name": "tro-ly-soan-de-mvp",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "uv run --project backend --frozen --no-dev --python 3.12 python -m uvicorn mach_backend.local_workspace:app --app-dir backend/src --host 127.0.0.1 --port 4182",
    "start:legacy": "node server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "build-editor": "esbuild editor-engine.js --bundle --format=esm --minify --outfile=assets/editor-engine.js",
    "setup-assets": "node setup-assets.mjs",
    "setup-local-ai": "node setup-local-ai.mjs",
    "setup-model": "node setup-model.mjs",
    "check:team": "node --test tests/team.test.mjs tests/github-bootstrap.test.mjs tests/task-details.test.mjs && node scripts/check-team.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-unique-id": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "docx": "9.6.1",
    "esbuild": "^0.25.12",
    "jszip": "3.10.1",
    "katex": "^0.16.22",
    "pdfjs-dist": "5.6.205",
    "playwright-core": "1.62.1",
    "tesseract.js": "7.0.0",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "pptxgenjs": "4.0.1"
  }
}
