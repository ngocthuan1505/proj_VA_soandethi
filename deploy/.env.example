# Copy to .env on the server, chmod 600 .env. Never commit it or send its contents in chat.
MACH_DOMAIN=exam-maker.example.com
APP_ADMIN_EMAIL=owner@example.com
# Generate on the server: openssl rand -hex 32
APP_SIGNUP_CODE=
# Optional JSON. With this blank, the owner configures AI in the app after login.
# Keys entered in the app last until restart. Environment secrets last across restarts.
APP_AI_CONFIG=
